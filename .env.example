# Copia este archivo como .env (o .env.local) y ajusta la URL.

# URL pública del backend. En desarrollo local, normalmente:
VITE_API_URL=http://localhost:3000

# Email de contacto que se muestra en el login para quien haya
# olvidado su contraseña (no hay recuperación automática por
# correo — ver docs/CONFIGURATION.md del backend). Opcional: si
# se deja vacío, ese aviso simplemente no aparece.
VITE_SUPPORT_EMAIL=
