# Copia este archivo como .env (o .env.local) y ajusta la URL.

# URL pública del backend. En desarrollo local, normalmente:
VITE_API_URL=http://localhost:3000

# Monitorización de errores en producción (opcional). Sin esto,
# la app funciona exactamente igual, solo que sin reportar
# errores a ningún sitio. DSN de un proyecto gratuito de sentry.io.
VITE_SENTRY_DSN=
